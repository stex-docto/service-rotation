# Values from the dev Firebase project's console (see firebase/.firebaserc
# for the dev/prod project aliases). Production values live in the
# ENV_FILE GitHub Actions secret instead, not in a tracked file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ---------------------------------------------------------------------
    // groups/{groupId}
    //
    // Lifecycle: draft -> open -> done. 'open' means voting is enabled
    // (services/rotations frozen) — it no longer gates membership. 'done' is
    // set by the creator once every current member's vote is locked (see
    // FinishGroupUseCase; this file cannot verify that itself, see clause
    // (h)) and changes nothing else — reading votes, computing a result, and
    // banning a member all behave exactly the same as in 'open'. There is
    // still no stored result — results are always computed live, locally, by
    // whoever can currently read enough votes (see votes/{uid} below and
    // README's security model). Membership
    // is fully self-service and email-free, and independent of status: the
    // group's own id (crypto.randomUUID(), unguessable, and groups are never
    // listable by non-members) is the invite capability from the moment the
    // group is created, gated only by the owner-controlled inviteOpen switch
    // below — there is no separate secret.
    // ---------------------------------------------------------------------
    match /groups/{groupId} {
      function ownVoteIsLocked() {
        return exists(/databases/$(database)/documents/groups/$(groupId)/votes/$(request.auth.uid))
          && get(/databases/$(database)/documents/groups/$(groupId)/votes/$(request.auth.uid)).data.locked == true;
      }

      // Tolerate documents written before banning existed: a plain
      // `resource.data.bannedUids` on one of those throws (missing map key)
      // and denies the whole request, not just the ban-specific checks.
      function existingBannedUids() {
        return ('bannedUids' in resource.data) ? resource.data.bannedUids : [];
      }
      function existingBannedMembers() {
        return ('bannedMembers' in resource.data) ? resource.data.bannedMembers : [];
      }
      // Same tolerance as existingBannedUids/existingBannedMembers above, for
      // documents written before this setting existed — every write is a
      // full-document set() (see FirebaseGroupDatastore), so this key
      // "appearing" for the first time shows up in every clause's diff, not
      // just (a) where it's actually editable.
      function existingAllowRepeatedServices() {
        return ('allowRepeatedServices' in resource.data) ? resource.data.allowRepeatedServices : false;
      }
      // Same tolerance, for the past-shift-history feature: pastShiftsEnabled
      // and shiftHistory are new fields, so every write to a group document
      // that predates this feature will otherwise look like it "changed"
      // these keys (absent -> present) even when it doesn't intend to touch
      // them — see existingAllowRepeatedServices above for the same shape.
      function existingPastShiftsEnabled() {
        return ('pastShiftsEnabled' in resource.data) ? resource.data.pastShiftsEnabled : false;
      }
      function existingShiftHistory() {
        return ('shiftHistory' in resource.data) ? resource.data.shiftHistory : {};
      }

      // Readable by any signed-in user who already knows its id, draft or
      // open — not gated on membership. This is deliberate, not a hole: the
      // id is a crypto.randomUUID() and groups are never listable by
      // non-members (see `list` below), so knowing it already required
      // having the shareable link, shown from the moment the group is
      // created. Self-join (see update clause (c)) needs a prior read of its
      // own to validate against the latest member list, and that read would
      // otherwise be denied to the exact people it's meant to serve.
      allow get: if isSignedIn();
      // `list` is always called with a query filtered by createdBy or by
      // memberUids (array-contains) — see GroupRepository — so the same
      // membership check applies to every document the query can return.
      // A non-member can never discover a groupId this way; the link itself
      // is the only way in.
      allow list: if isSignedIn() && (
        request.auth.uid == resource.data.createdBy ||
        request.auth.uid in resource.data.memberUids
      );

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.members.size() == 0
        && request.resource.data.memberUids.size() == 0
        && request.resource.data.inviteOpen == true
        && request.resource.data.bannedMembers.size() == 0
        && request.resource.data.bannedUids.size() == 0;

      allow update: if isSignedIn() && (
        // (a) Creator edits a draft's configuration freely — services,
        // name, rotations. Members may already exist by this point (joining
        // doesn't wait for voting to be enabled), so this clause touches
        // only configuration fields, never membership or the invite lock.
        // bannedMembers/bannedUids are listed only to tolerate them
        // "appearing" on a document written before banning existed (see
        // existingBannedUids) — pinned equal to their prior value so this
        // clause can never be used to sneak in an actual ban/unban.
        (
          resource.data.status == 'draft'
          && request.auth.uid == resource.data.createdBy
          && request.resource.data.status == 'draft'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['name', 'services', 'rotationSlots', 'rotationMode', 'allowRepeatedServices',
                'bannedMembers', 'bannedUids', 'pastShiftsEnabled', 'shiftHistory']
             )
          && request.resource.data.bannedUids == existingBannedUids()
          && request.resource.data.bannedMembers.size() == existingBannedMembers().size()
        )
        ||
        // (b) Creator enables voting: freezes services/rotations and locks
        // the roster (inviteOpen -> false) in the same write — activating
        // voting is the default moment the member list stops moving.
        // Reversible afterward via clause (e), same as any other time.
        // allowRepeatedServices/bannedMembers/bannedUids pinned unchanged —
        // see (a).
        (
          resource.data.status == 'draft'
          && request.auth.uid == resource.data.createdBy
          && request.resource.data.status == 'open'
          && request.resource.data.inviteOpen == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['status', 'inviteOpen', 'allowRepeatedServices', 'bannedMembers', 'bannedUids',
                'pastShiftsEnabled', 'shiftHistory']
             )
          && request.resource.data.bannedUids == existingBannedUids()
          && request.resource.data.bannedMembers.size() == existingBannedMembers().size()
          && request.resource.data.allowRepeatedServices == existingAllowRepeatedServices()
          && request.resource.data.pastShiftsEnabled == existingPastShiftsEnabled()
          && request.resource.data.shiftHistory == existingShiftHistory()
        )
        ||
        // (c) Self-join: exactly your own uid, added once, invite must be
        // open, and the uid must not be on the banned list — a banned
        // member can't simply rejoin through this clause (see Group.join).
        // Works in 'draft' or 'open' — no organizer approval, no need to
        // wait for voting to be enabled. Checking that the new `members`
        // array is the old one with exactly one element appended, AND that
        // element's userId is the caller's own, rules out sneaking in
        // someone else's entry or tampering with an existing one under cover
        // of a join. allowRepeatedServices/bannedMembers/bannedUids pinned
        // unchanged — see (a) — so a joiner can't also ban/unban someone or
        // toggle a setting in the same write.
        (
          resource.data.inviteOpen == true
          && !(request.auth.uid in existingBannedUids())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['members', 'memberUids', 'allowRepeatedServices', 'bannedMembers', 'bannedUids',
                'pastShiftsEnabled', 'shiftHistory']
             )
          && request.resource.data.bannedUids == existingBannedUids()
          && request.resource.data.bannedMembers.size() == existingBannedMembers().size()
          && request.resource.data.allowRepeatedServices == existingAllowRepeatedServices()
          && request.resource.data.pastShiftsEnabled == existingPastShiftsEnabled()
          && request.resource.data.shiftHistory == existingShiftHistory()
          && !(request.auth.uid in resource.data.memberUids)
          && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
          && request.resource.data.members == resource.data.members.concat(
               [request.resource.data.members[request.resource.data.members.size() - 1]]
             )
          && request.resource.data.members[request.resource.data.members.size() - 1].userId == request.auth.uid
        )
        ||
        // (d) Self-leave: exactly your own uid, removed. Works in 'draft' or
        // 'open', and regardless of the invite lock — that lock only stops
        // new joins. Blocked once your own vote is locked — permanent
        // membership from that point on is what keeps capacity math and
        // "everyone's voted" meaningful; see CLAUDE.md.
        // allowRepeatedServices/bannedMembers/bannedUids pinned unchanged —
        // see (a).
        (
          request.auth.uid in resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['members', 'memberUids', 'allowRepeatedServices', 'bannedMembers', 'bannedUids',
                'pastShiftsEnabled', 'shiftHistory']
             )
          && request.resource.data.bannedUids == existingBannedUids()
          && request.resource.data.bannedMembers.size() == existingBannedMembers().size()
          && request.resource.data.allowRepeatedServices == existingAllowRepeatedServices()
          && request.resource.data.pastShiftsEnabled == existingPastShiftsEnabled()
          && request.resource.data.shiftHistory == existingShiftHistory()
          && !(request.auth.uid in request.resource.data.memberUids)
          && request.resource.data.memberUids == resource.data.memberUids.removeAll([request.auth.uid])
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && !ownVoteIsLocked()
        )
        ||
        // (e) Creator locks the invite link — usable in 'draft' or 'open',
        // any number of times. It only ever stops new joins; it has no
        // effect on anyone's ability to leave, vote, or read votes.
        // allowRepeatedServices/bannedMembers/bannedUids pinned unchanged —
        // see (a).
        (
          request.auth.uid == resource.data.createdBy
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['inviteOpen', 'allowRepeatedServices', 'bannedMembers', 'bannedUids',
                'pastShiftsEnabled', 'shiftHistory']
             )
          && request.resource.data.bannedUids == existingBannedUids()
          && request.resource.data.bannedMembers.size() == existingBannedMembers().size()
          && request.resource.data.allowRepeatedServices == existingAllowRepeatedServices()
          && request.resource.data.pastShiftsEnabled == existingPastShiftsEnabled()
          && request.resource.data.shiftHistory == existingShiftHistory()
          && resource.data.inviteOpen == true
          && request.resource.data.inviteOpen == false
        )
        ||
        // (e2) Creator reopens the invite link — 'draft' only. Once voting
        // is enabled the roster is locked for good (see Group.reopenInvite):
        // letting someone join after other members have already started
        // grading would be unfair to whoever committed to the current
        // member list first. allowRepeatedServices/bannedMembers/bannedUids
        // pinned unchanged — see (a).
        (
          resource.data.status == 'draft'
          && request.auth.uid == resource.data.createdBy
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['inviteOpen', 'allowRepeatedServices', 'bannedMembers', 'bannedUids',
                'pastShiftsEnabled', 'shiftHistory']
             )
          && request.resource.data.bannedUids == existingBannedUids()
          && request.resource.data.bannedMembers.size() == existingBannedMembers().size()
          && request.resource.data.allowRepeatedServices == existingAllowRepeatedServices()
          && request.resource.data.pastShiftsEnabled == existingPastShiftsEnabled()
          && request.resource.data.shiftHistory == existingShiftHistory()
          && resource.data.inviteOpen == false
          && request.resource.data.inviteOpen == true
        )
        ||
        // (f) Creator bans a member: forced removal of exactly one existing
        // member, any time, regardless of status, the invite lock, or that
        // member's own vote lock — a moderation override, not something the
        // removed member could use to dodge an assignment. Checking that the
        // new memberUids has no id absent from the old one rules out this
        // clause being used to sneak in a join disguised as a ban. Also
        // appends exactly one entry to bannedUids/bannedMembers in the same
        // write, so a future self-join by that uid is rejected by clause (c)
        // — see Group.ban. Not cross-validated against which specific uid
        // was removed from memberUids: the creator already has unrestricted
        // ban power over their own group, and the `members` check just below
        // is equally loose (size-only, no content check either).
        (
          request.auth.uid == resource.data.createdBy
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['members', 'memberUids', 'allowRepeatedServices', 'bannedMembers', 'bannedUids',
                'pastShiftsEnabled', 'shiftHistory']
             )
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
          && request.resource.data.memberUids.removeAll(resource.data.memberUids).size() == 0
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && request.resource.data.bannedUids.size() == existingBannedUids().size() + 1
          && existingBannedUids().removeAll(request.resource.data.bannedUids).size() == 0
          && request.resource.data.bannedMembers.size() == existingBannedMembers().size() + 1
          && request.resource.data.allowRepeatedServices == existingAllowRepeatedServices()
          && request.resource.data.pastShiftsEnabled == existingPastShiftsEnabled()
          && request.resource.data.shiftHistory == existingShiftHistory()
        )
        ||
        // (g) Creator undoes a ban — a misclick undo, not a way to
        // relitigate a moderation decision after the fact: only available
        // while the roster itself isn't locked (inviteOpen == true), the
        // same window join() itself requires — see Group.unban. Does not
        // touch members/memberUids: the unbanned uid still has to rejoin
        // themselves through the normal self-service flow.
        (
          request.auth.uid == resource.data.createdBy
          && resource.data.inviteOpen == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['allowRepeatedServices', 'bannedMembers', 'bannedUids',
                'pastShiftsEnabled', 'shiftHistory']
             )
          && request.resource.data.bannedUids.size() == existingBannedUids().size() - 1
          && request.resource.data.bannedUids.removeAll(existingBannedUids()).size() == 0
          && request.resource.data.bannedMembers.size() == existingBannedMembers().size() - 1
          && request.resource.data.allowRepeatedServices == existingAllowRepeatedServices()
          && request.resource.data.pastShiftsEnabled == existingPastShiftsEnabled()
          && request.resource.data.shiftHistory == existingShiftHistory()
        )
        ||
        // (h) Creator marks voting as finished: 'open' -> 'done', status
        // only. Rules can't check that every member's vote is actually
        // locked (no loop over an arbitrary member count, no per-doc get()
        // budget for that) — FinishGroupUseCase is what actually enforces
        // it; this clause only pins every other field unchanged, same
        // pattern as (a)-(g). inviteOpen isn't in the pinned list because
        // it's already false from open() and stays false — see (b) and the
        // absence of any 'done'-state reopen path.
        (
          resource.data.status == 'open'
          && request.auth.uid == resource.data.createdBy
          && request.resource.data.status == 'done'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['status', 'allowRepeatedServices', 'bannedMembers', 'bannedUids',
                'pastShiftsEnabled', 'shiftHistory']
             )
          && request.resource.data.bannedUids == existingBannedUids()
          && request.resource.data.bannedMembers.size() == existingBannedMembers().size()
          && request.resource.data.allowRepeatedServices == existingAllowRepeatedServices()
          && request.resource.data.pastShiftsEnabled == existingPastShiftsEnabled()
          && request.resource.data.shiftHistory == existingShiftHistory()
        )
      );

      // Only a draft nobody but the creator has joined can be deleted. The
      // creator is always a member from creation on (see CreateGroupUseCase),
      // so "no members yet" is never true any more — the real bar is "no
      // OTHER member has joined", i.e. at most the creator's own entry.
      allow delete: if isSignedIn()
        && resource.data.status == 'draft'
        && request.auth.uid == resource.data.createdBy
        && (
          resource.data.members.size() == 0
          || (
            resource.data.members.size() == 1
            && resource.data.memberUids[0] == resource.data.createdBy
          )
        );

      // ---------------------------------------------------------------------
      // groups/{groupId}/votes/{uid} — the actual grades. Private to the
      // voter until locked; even then, readable by another member only if
      // THAT member's own vote is ALSO locked — see canReadVote below. This
      // holds for every member equally, including the creator: there is no
      // standing organizer access to anyone's grades any more. Nobody can
      // act on what they see here either way, since by the time you can
      // read anything your own vote must already be locked and unchangeable.
      // ---------------------------------------------------------------------
      match /votes/{uid} {
        function parentGroup() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }
        function isOwnVote() {
          return isSignedIn() && request.auth.uid == uid;
        }
        function callerVoteIsLocked() {
          return exists(/databases/$(database)/documents/groups/$(groupId)/votes/$(request.auth.uid))
            && get(/databases/$(database)/documents/groups/$(groupId)/votes/$(request.auth.uid)).data.locked == true;
        }
        function canReadVote() {
          return isOwnVote() || (resource.data.locked == true && callerVoteIsLocked());
        }

        allow get: if isSignedIn() && canReadVote();
        allow create: if isOwnVote()
          && parentGroup().status == 'open'
          && uid in parentGroup().memberUids
          && request.resource.data.locked == false;
        allow update: if isOwnVote() && (
          // Editing a still-unlocked draft.
          (
            resource.data.locked == false
            && request.resource.data.locked == false
          )
          ||
          // Locking — one-way (see VoteEntity.lock), and this specific write
          // may only flip locked/lockedAt, never the grades themselves.
          (
            resource.data.locked == false
            && request.resource.data.locked == true
            && request.resource.data.grades == resource.data.grades
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['locked', 'lockedAt'])
          )
        );
        allow delete: if false;
      }

      // ---------------------------------------------------------------------
      // groups/{groupId}/voteStatus/{uid} — ALWAYS public within the group
      // (locked: boolean only, never grade content). Lets any member see
      // voting progress and know which uids are worth a full read attempt,
      // without exposing anyone's actual grades — see FirebaseVoteDatastore.
      // ---------------------------------------------------------------------
      match /voteStatus/{uid} {
        function parentGroup() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }
        function isGroupMember() {
          return isSignedIn() && (
            request.auth.uid in parentGroup().memberUids || request.auth.uid == parentGroup().createdBy
          );
        }

        allow get: if isGroupMember();
        allow list: if isGroupMember();
        allow create: if isSignedIn()
          && request.auth.uid == uid
          && parentGroup().status == 'open'
          && uid in parentGroup().memberUids
          && request.resource.data.locked == false;
        allow update: if isSignedIn()
          && request.auth.uid == uid
          && resource.data.locked == false
          && (
            // Re-saving a still-unlocked draft — saveDraft always writes
            // locked: false, so this is a no-op on this field. Without this
            // branch, every save after the first (which hits `create`) is
            // an `update` that only the locking branch below would match.
            request.resource.data.locked == false
            ||
            // Locking — one-way, and this write may only flip `locked`.
            (
              request.resource.data.locked == true
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['locked'])
            )
          );
        allow delete: if false;
      }

      // ---------------------------------------------------------------------
      // groups/{groupId}/shiftHistoryProposals/{uid} — a member's proposed
      // correction to their own row of the group document's shiftHistory
      // map. The organizer stays the sole writer of that map itself (see
      // README's honesty argument); this only lets a member flag a wrong
      // number and the creator accept or reject it, with the outcome as
      // visible to the group as the number it's about. Draft-only, same as
      // shiftHistory itself.
      // ---------------------------------------------------------------------
      match /shiftHistoryProposals/{uid} {
        function parentGroup() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }
        function isGroupMember() {
          return isSignedIn() && (
            request.auth.uid in parentGroup().memberUids || request.auth.uid == parentGroup().createdBy
          );
        }

        allow get: if isGroupMember();
        allow list: if isGroupMember();

        // A member proposes (or re-proposes, overwriting their own still-
        // pending draft) a correction to their own row.
        allow create: if isSignedIn()
          && request.auth.uid == uid
          && parentGroup().status == 'draft'
          && uid in parentGroup().memberUids
          && request.resource.data.status == 'pending';
        allow update: if isSignedIn() && (
          // The proposer edits their own proposal, or reopens a resolved
          // one back to pending — see ShiftHistoryProposalEntity.resolve:
          // a rejected proposal isn't the end of the conversation, and a
          // fresh one is exactly as visible as the first.
          (
            request.auth.uid == uid
            && parentGroup().status == 'draft'
            && request.resource.data.status == 'pending'
          )
          ||
          // The creator resolves it — flips status only, never the numbers
          // or justification, so "rejected" can never double as a silent
          // edit of what was actually proposed.
          (
            request.auth.uid == parentGroup().createdBy
            && resource.data.status == 'pending'
            && (request.resource.data.status == 'accepted' ||
                request.resource.data.status == 'rejected')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          )
        );
        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------------
    // users/{uid} — private per-user space. Currently just which groups this
    // user has chosen to hide from their own "my groups" list (see
    // SetGroupHiddenUseCase) — never affects membership, votes, or anyone
    // else's view of anything.
    // ---------------------------------------------------------------------
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
